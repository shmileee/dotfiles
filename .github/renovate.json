{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "updateNotScheduled": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "groupSingleUpdates": true,
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "semanticCommitType": "fix",
    "semanticCommitScope": "security"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated shell variables",
      "managerFilePatterns": [
        "/^bootstrap\\/setup\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Za-z_][A-Za-z0-9_]*=(?<currentValue>\\S+)"
      ]
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "/^mise\\/conf\\.d\\/[^/]+\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Use CI commit semantics for GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group dependencies used by the bootstrap runtime",
      "matchFileNames": [
        "bootstrap/**"
      ],
      "groupName": "runtime dependencies",
      "groupSlug": "bootstrap",
      "semanticCommitType": "chore",
      "semanticCommitScope": "bootstrap"
    },
    {
      "description": "Group Ansible content used to provision machines",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchFileNames": [
        "bootstrap/ansible/requirements.yml"
      ],
      "groupName": "provisioning dependencies",
      "groupSlug": "ansible",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ansible"
    },
    {
      "description": "Group tools used to develop and validate this repository",
      "matchManagers": [
        "mise"
      ],
      "matchFileNames": [
        "mise/conf.d/10-validation.toml"
      ],
      "groupName": "development dependencies",
      "groupSlug": "development-dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "tooling"
    },
    {
      "description": "Include pre-commit hooks in the development dependency group",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "development dependencies",
      "groupSlug": "development-dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "tooling"
    },
    {
      "description": "Group tools used by bootstrap tests",
      "matchManagers": [
        "mise"
      ],
      "matchFileNames": [
        "mise/conf.d/20-bootstrap.toml"
      ],
      "groupName": "bootstrap test dependencies",
      "groupSlug": "bootstrap-test-dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "bootstrap"
    },
    {
      "description": "Keep workstation changes separate from repository tooling",
      "matchManagers": [
        "mise"
      ],
      "matchFileNames": [
        "config/private_dot_config/mise/config.toml"
      ],
      "groupName": "toolchain",
      "groupSlug": "workstation-toolchain",
      "semanticCommitType": "chore",
      "semanticCommitScope": "workstation"
    },
    {
      "description": "Use build commit semantics for Docker dependencies",
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group Docker updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Dockerfile",
        "tests/integration/Dockerfile"
      ],
      "groupName": "container images",
      "groupSlug": "container-images"
    },
    {
      "description": "Keep bootstrap Python declarations synchronized",
      "matchDepNames": [
        "python"
      ],
      "matchFileNames": [
        "bootstrap/.python-version",
        "bootstrap/pyproject.toml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "groupName": "bootstrap Python",
      "groupSlug": "bootstrap-python",
      "minimumGroupSize": 2,
      "semanticCommitType": "chore",
      "semanticCommitScope": "bootstrap"
    },
    {
      "description": "Keep bootstrap uv declarations synchronized",
      "matchDepNames": [
        "uv",
        "astral-sh/uv",
        "ghcr.io/astral-sh/uv"
      ],
      "matchFileNames": [
        "mise.toml",
        "bootstrap/setup.sh",
        "tests/integration/Dockerfile"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "groupName": "bootstrap uv",
      "groupSlug": "bootstrap-uv",
      "minimumGroupSize": 3,
      "semanticCommitType": "chore",
      "semanticCommitScope": "bootstrap"
    },
    {
      "description": "Rely on the timestamped bootstrap Python declaration",
      "matchManagers": [
        "pyenv"
      ],
      "matchFileNames": [
        "bootstrap/.python-version"
      ],
      "matchPackageNames": [
        "python"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Rely on the timestamped bootstrap uv declarations",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "tests/integration/Dockerfile"
      ],
      "matchPackageNames": [
        "ghcr.io/astral-sh/uv"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Skip lock-file maintenance for Mise without lockfiles",
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "enabled": false
    },
    {
      "description": "Allow for the slower release cadence of stable tooling",
      "matchPackageNames": [
        "koalaman/shellcheck"
      ],
      "abandonmentThreshold": "2 years"
    }
  ]
}
