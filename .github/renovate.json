{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":enablePreCommit"],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "groupSingleUpdates": true,
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days",
    "semanticCommitType": "fix",
    "semanticCommitScope": "security"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/setup\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nreadonly uv_version=\"\\$\\{UV_BOOTSTRAP_VERSION:-(?<currentValue>[^}]+)\\}\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group updates across the repository's GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group documentation build dependencies",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements-docs.txt"],
      "groupName": "documentation dependencies",
      "groupSlug": "docs",
      "semanticCommitType": "docs",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group Ansible content used to provision machines",
      "matchManagers": ["ansible-galaxy", "pep621"],
      "matchFileNames": [
        "scripts/common/ansible/requirements.yml",
        "scripts/common/ansible/pyproject.toml"
      ],
      "groupName": "provisioning dependencies",
      "groupSlug": "ansible",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ansible"
    },
    {
      "description": "Group tools used to develop and validate this repository",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "groupName": "repository toolchain",
      "groupSlug": "repo-toolchain",
      "semanticCommitType": "chore",
      "semanticCommitScope": "tooling"
    },
    {
      "description": "Include pre-commit hooks in the repository toolchain group",
      "matchManagers": ["pre-commit"],
      "groupName": "repository toolchain",
      "groupSlug": "repo-toolchain",
      "semanticCommitType": "chore",
      "semanticCommitScope": "tooling"
    },
    {
      "description": "Keep the stage-zero and repository uv versions synchronized",
      "matchPackageNames": ["astral-sh/uv", "uv"],
      "matchFileNames": ["scripts/setup.sh", "mise.toml"],
      "groupName": "bootstrap uv",
      "groupSlug": "bootstrap-uv",
      "semanticCommitType": "chore",
      "semanticCommitScope": "bootstrap"
    },
    {
      "description": "Keep workstation changes separate from repository tooling",
      "matchManagers": ["mise"],
      "matchFileNames": ["config/private_dot_config/mise/config.toml"],
      "groupName": "workstation toolchain",
      "groupSlug": "workstation-toolchain",
      "semanticCommitType": "chore",
      "semanticCommitScope": "workstation"
    },
    {
      "description": "Group the runtime and frontend images used by Docker builds",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile"],
      "groupName": "container images",
      "groupSlug": "container-images",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Allow for the slower release cadence of stable tooling",
      "matchPackageNames": ["koalaman/shellcheck"],
      "abandonmentThreshold": "2 years"
    }
  ]
}
