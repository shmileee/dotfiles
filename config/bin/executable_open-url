#!/bin/bash
# URL handler for Alacritty's hyperlink hint (see alacritty.toml).
#
# file:// URLs open in nvim inside a new tmux window (honoring a trailing
# #L<line> fragment, as emitted by opencode & friends). macOS `open` can't
# handle them: extensions like .tmpl have no associated app, so clicking a
# file link silently fails with kLSApplicationNotFoundErr. Everything else
# falls through to the system opener.
set -euo pipefail

url="${1:?usage: open-url <url>}"

# Alacritty is a GUI app; its PATH may lack Homebrew.
export PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

if [[ "$url" != file://* ]]; then
  if command -v open > /dev/null 2>&1; then
    exec open "$url"
  else
    exec xdg-open "$url"
  fi
fi

# file://host/path -> /path, drop #fragment (kept for the line number),
# percent-decode.
path_and_frag="${url#file://}"
path_and_frag="${path_and_frag#localhost}"
fragment=""
path="$path_and_frag"
if [[ "$path_and_frag" == *#* ]]; then
  fragment="${path_and_frag##*#}"
  path="${path_and_frag%#*}"
fi
path=$(printf '%s' "$path" | python3 -c 'import sys, urllib.parse; sys.stdout.write(urllib.parse.unquote(sys.stdin.read()))')

# "#L28" or "#L15-L23" -> 28 / 15
line=""
if [[ "$fragment" =~ ^L?([0-9]+) ]]; then
  line="${BASH_REMATCH[1]}"
fi

# Absolute path: the pane's shell inherits the (PATH-stripped) Alacritty
# client environment, so a bare "nvim" fails with 127 there. nvim is
# mise-managed, so it's not on this script's PATH either — ask mise.
nvim_bin=$(command -v nvim || true)
if [[ -z "$nvim_bin" ]]; then
  nvim_bin=$(mise which nvim 2> /dev/null || true)
fi
: "${nvim_bin:?nvim not found via PATH or mise}"
nvim_cmd="$nvim_bin"
if [[ -n "$line" ]]; then
  nvim_cmd="$nvim_bin +$line"
fi

# Alacritty spawns this script outside tmux, where a bare new-window may pick
# an arbitrary session — explicitly target the most recently active attached
# client's session (the one the click came from).
session=$(tmux list-clients -F '#{client_activity} #{session_name}' 2> /dev/null | sort -rn | head -1 | cut -d' ' -f2-)

if [[ -n "$session" ]]; then
  exec tmux new-window -t "$session" -n nvim -c "$(dirname "$path")" "$nvim_cmd $(printf '%q' "$path")"
fi
exec tmux new-window -n nvim -c "$(dirname "$path")" "$nvim_cmd $(printf '%q' "$path")"
