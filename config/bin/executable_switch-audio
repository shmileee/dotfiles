#!/usr/bin/env bash
#
# Requirements:
#   - switchaudio-osx (brew install switchaudio-osx)
#
# Usage:
#
#   Switch between speakers / headphones:
#   - switch-audio headphones
#   - switch-audio speakers
#

set -e

if ! command -v "SwitchAudioSource" &> /dev/null; then
  echo "SwitchAudioSource could not be found."
  echo "Run:"
  echo "  - brew install switchaudio-osx"
  exit 1
fi

set_speakers() {
  SwitchAudioSource -t input -s "MacBook Pro Microphone"
  SwitchAudioSource -t output -s "MacBook Pro Speakers"
}

set_headphones() {
  SwitchAudioSource -t input -s "Jabra Evolve2 40 SE"
  SwitchAudioSource -t output -s "Jabra Evolve2 40 SE"
}

toggle() {
  local current_device
  current_device=$(SwitchAudioSource -c)
  if test "${current_device}" == "MacBook Pro Speakers"; then
    set_headphones
  elif test "${current_device}" == "Jabra Evolve2 40 SE"; then
    set_speakers
  fi
}

case "$1" in
  headphones)
    set_headphones
    ;;
  speakers)
    set_speakers
    ;;
  *)
    toggle
    ;;
esac
