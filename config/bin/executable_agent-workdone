#!/bin/sh

set -eu

# Finish an agentic task once its pull request merged. Squash-merged branches
# look unmerged locally, so a plain `workmux remove` prompts for confirmation;
# this verifies that a MERGED pull request exists for the branch AND that its
# head commit matches the local branch tip (reused slugs or amended local
# commits refuse instead of force-removing unmerged work) AND that the task
# worktree has no uncommitted changes, then removes the worktree, tmux window,
# and local branch. Run it inside the task's worktree, or pass the slug.

fail() {
  printf '[agent-workdone] Error: %s\n' "$1" >&2
  exit 1
}

usage() {
  printf 'Usage: %s [task-slug]\n' "$0"
}

parse_arguments() {
  case $# in
    0)
      task_slug=$(git rev-parse --abbrev-ref HEAD)
      # Detached HEAD prints the literal 'HEAD' and is not a task branch.
      [ "$task_slug" != HEAD ] || fail 'detached HEAD; pass the task slug explicitly.'
      ;;
    1)
      case $1 in
        -h | --help)
          usage
          exit 0
          ;;
        *) task_slug=$1 ;;
      esac
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

guard_project_workmux_config() {
  # `workmux remove` executes repository-controlled pre_remove hooks from
  # .workmux.yaml and exposes no flag to disable them (verified during
  # security review), so refuse automation when one is present.
  repository_root=$(git rev-parse --show-toplevel)
  main_worktree=$(git worktree list | sed -n '1s/ .*//p')
  for config_dir in "$repository_root" "$main_worktree"; do
    if [ -f "$config_dir/.workmux.yaml" ]; then
      fail "$config_dir/.workmux.yaml exists; inspect it and run 'workmux remove $task_slug' manually."
    fi
  done
}

verify_merged_pull_request() {
  # --head avoids `gh pr view` misreading numeric slugs as PR numbers, and a
  # failed gh call (auth/network) is reported as unverifiable instead of
  # being conflated with "no PR".
  if ! merged_head_oid=$(gh pr list --head "$task_slug" --state merged \
    --json headRefOid --jq '.[0].headRefOid' 2> /dev/null); then
    fail "gh could not check pull requests for '$task_slug' (auth/network?); nothing was removed."
  fi

  if [ -z "$merged_head_oid" ]; then
    printf '[agent-workdone] No merged pull request found for %s.\n' "$task_slug" >&2
    printf '  local merge:  workmux merge %s\n' "$task_slug" >&2
    printf '  just remove:  workmux remove %s\n' "$task_slug" >&2
    exit 1
  fi

  local_head_oid=$(git rev-parse --verify --quiet "refs/heads/$task_slug") \
    || fail "no local branch '$task_slug' to compare against the merged pull request."
  if [ "$merged_head_oid" != "$local_head_oid" ]; then
    fail "merged PR head $merged_head_oid does not match local $task_slug tip $local_head_oid (reused slug or unpushed commits); refusing to clean up."
  fi
}

verify_clean_worktree() {
  # The merged-PR check above compares commits, which says nothing about the
  # working tree, and `workmux remove --force` skips workmux's own dirty-state
  # prompt. Without this guard, uncommitted or untracked files in the task
  # worktree are destroyed silently.
  task_worktree=$(git worktree list --porcelain \
    | awk -v branch="refs/heads/$task_slug" '
        /^worktree / { path = substr($0, 10) }
        /^branch /   { if (substr($0, 8) == branch) { print path; exit } }
      ')
  # No checked-out worktree for the branch means there is no working tree to
  # lose; workmux just deletes the branch.
  [ -n "$task_worktree" ] || return 0

  worktree_status=$(git -C "$task_worktree" status --porcelain) \
    || fail "could not inspect '$task_worktree' for uncommitted changes; nothing was removed."
  if [ -n "$worktree_status" ]; then
    printf '[agent-workdone] Uncommitted changes in %s:\n' "$task_worktree" >&2
    printf '%s\n' "$worktree_status" >&2
    fail 'refusing to remove a worktree with uncommitted changes; commit, stash, or discard them first.'
  fi
}

main() {
  parse_arguments "$@"
  guard_project_workmux_config
  verify_merged_pull_request
  verify_clean_worktree
  exec workmux remove --force "$task_slug"
}

main "$@"
