#!/bin/sh

set -eu
set -f

program=${0##*/}

usage() {
  cat << EOF
Usage: ${program} COMMAND

Commands:
  list    list running SSM-managed instances
  start   interactively select an instance and start a session
EOF
}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" > /dev/null 2>&1 || die "$1 is required"
}

managed_instance_ids() {
  require_command aws

  aws ssm describe-instance-information \
    --query 'InstanceInformationList[].InstanceId' \
    --output text \
    --no-cli-pager
}

list_instances() {
  instance_ids=$(managed_instance_ids)
  [ -n "$instance_ids" ] || return 0

  old_ifs=$IFS
  IFS=$(printf ' \t')
  # EC2 instance IDs contain no shell metacharacters or whitespace.
  # shellcheck disable=SC2086
  set -- $instance_ids
  IFS=$old_ifs

  aws ec2 describe-instances \
    --instance-ids "$@" \
    --filters 'Name=instance-state-name,Values=running' \
    --query "Reservations[*].Instances[*].[InstanceId,Tags[?Key=='Name']|[0].Value]" \
    --output text \
    --no-cli-pager
}

start_session() {
  require_command fzf

  instances=$(list_instances)
  [ -n "$instances" ] || die 'no running SSM-managed instances found'

  if selected_instance=$(printf '%s\n' "$instances" | fzf); then
    :
  else
    status=$?
    exit "$status"
  fi
  [ -n "$selected_instance" ] || die 'no instance selected'

  target=$(printf '%s\n' "$selected_instance" | cut -f 1)
  [ -n "$target" ] || die 'could not determine the selected instance ID'

  # Ignore Ctrl-C locally so it is delivered to the remote session instead.
  trap '' INT
  aws ssm start-session --target "$target"
}

[ "$#" -eq 1 ] || {
  usage >&2
  exit 2
}

case $1 in
  list) list_instances ;;
  start) start_session ;;
  -h | --help) usage ;;
  *)
    usage >&2
    die "unknown command: $1"
    ;;
esac
