#!/usr/bin/env bash
#
# Requirements:
#   - AWS CLI
#   - Session Manager plugin
#   - fzf
#
# Usage:
#
#   List available instances:
#    ssm-session list
#
#  Connect to instance (uses fzf to provide interactive list)
#    ssm-session start

set -o pipefail

ssm_instance_ids() {
  aws ssm describe-instance-information --query "InstanceInformationList[].InstanceId" \
    --output=text
}

list_instances() {
  local instance_ids=() line_ids instance_ids_text
  instance_ids_text=$(ssm_instance_ids) || return $?

  # AWS text output separates IDs with whitespace, including paginated lines.
  while IFS=$' \t\n' read -r -a line_ids; do
    instance_ids+=("${line_ids[@]}")
  done <<< "${instance_ids_text}"
  [[ ${#instance_ids[@]} -gt 0 ]] || return 0

  aws ec2 describe-instances \
    --instance-ids "${instance_ids[@]}" \
    --filters "Name=instance-state-name,Values=running" \
    --query "Reservations[*].Instances[*].[InstanceId,Tags[?Key=='Name']|[0].Value]" \
    --output text
}

print_usage() {
  cat <<- EOF
usage: ssm-session <command>
command:
    list:  List target sessions
    start: Start session manager
EOF
}

case "$1" in
  list)
    list_instances

    ;;
  start)
    # Ignore SIGINT(Ctrl-C) to prevent accidental exit from session
    trap '' 2

    target=$(list_instances | fzf | cut -f 1) || exit $?
    [[ -n "${target}" ]] || exit 0
    printf '%s\n' "${target}" \
      | xargs -o aws ssm start-session --target

    ;;
  *)
    print_usage
    exit 1
    ;;
esac
