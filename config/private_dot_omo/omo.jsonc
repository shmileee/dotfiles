// OMO configuration
//
// Models follow OMO's built-in AGENT_MODEL_REQUIREMENTS / CATEGORY_MODEL_REQUIREMENTS
// chains, filtered to the anthropic + openai providers. Where OMO's chain has no
// second anthropic/openai entry (prometheus, metis, hephaestus, multimodal-looker,
// writing) a same-tier cross-provider fallback is added so a 429/5xx is not a
// hard stop; hephaestus must stay on a GPT model.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "disabled_hooks": ["session-notification"],
    "hashline_edit": true,
    "telemetry": false,
    "experimental": {
      "preemptive_compaction": true,
      "dynamic_context_pruning": { "enabled": true }
    },
    "agents": {
      "sisyphus": {
        "model": "anthropic/claude-opus-5",
        "reasoning": "max",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
        ]
      },
      "prometheus": {
        "model": "anthropic/claude-fable-5-1",
        "reasoning": "xhigh",
        "fallback_models": [
          { "model": "openai/gpt-6-astra", "reasoning": "high" }
        ]
      },
      "metis": {
        "model": "anthropic/claude-opus-5",
        "reasoning": "high",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "reasoning": "high" }
        ]
      },
      "momus": {
        "model": "openai/gpt-6-astra",
        "reasoning": "xhigh",
        "fallback_models": [
          { "model": "anthropic/claude-opus-5", "reasoning": "max" }
        ]
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh",
        "fallback_models": [
          { "model": "anthropic/claude-opus-5", "reasoning": "max" }
        ]
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium",
        "fallback_models": [
          { "model": "openai/gpt-5.6-terra", "reasoning": "medium" }
        ]
      },
      "atlas": {
        "model": "anthropic/claude-sonnet-5",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
        ]
      },
      "sisyphus-junior": {
        "model": "anthropic/claude-sonnet-5",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
        ]
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "low",
        "fallback_models": [{ "model": "anthropic/claude-haiku-4-5" }]
      },
      "explore": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "low",
        "fallback_models": [{ "model": "anthropic/claude-haiku-4-5" }]
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "low",
        "fallback_models": [
          { "model": "anthropic/claude-sonnet-5", "reasoning": "low" }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "anthropic/claude-fable-5-1",
        "reasoning": "max",
        "fallback_models": [
          { "model": "anthropic/claude-opus-5", "reasoning": "max" }
        ]
      },
      "artistry": {
        "model": "anthropic/claude-fable-5-1",
        "reasoning": "max",
        "fallback_models": [
          { "model": "anthropic/claude-opus-5", "reasoning": "xhigh" }
        ]
      },
      "ultrabrain": {
        "model": "openai/gpt-6-astra",
        "reasoning": "max",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "reasoning": "max" }
        ]
      },
      "deep": {
        "model": "openai/gpt-6-astra",
        "reasoning": "high",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
        ]
      },
      "writing": {
        "model": "anthropic/claude-fable-5-1",
        "reasoning": "medium",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "reasoning": "medium" }
        ]
      },
      "quick": {
        "model": "openai/gpt-5.6-luna-fast",
        "reasoning": "low",
        "fallback_models": [{ "model": "anthropic/claude-haiku-4-5" }]
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high",
        "fallback_models": [
          { "model": "anthropic/claude-sonnet-5", "reasoning": "low" }
        ]
      },
      "unspecified-high": {
        "model": "openai/gpt-6-astra",
        "reasoning": "high",
        "fallback_models": [
          { "model": "anthropic/claude-opus-5", "reasoning": "xhigh" }
        ]
      }
    },
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false
    },
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": false,
      "retry_on_errors": [402, 429, 500, 502, 503, 504, 529],
      "max_fallback_attempts": 1,
      "cooldown_seconds": 60,
      "timeout_seconds": 30,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": false
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}
