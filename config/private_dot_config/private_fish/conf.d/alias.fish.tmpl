# set up aliases

status is-interactive; or return

{{- if (eq .chezmoi.os "darwin") }}
if command -q gsed
  alias sed 'gsed'
end
{{- end }}

{{- if eq .chezmoi.os "linux" }}
# emulate pbcopy/pbpaste
alias pbcopy 'xclip -selection clipboard'
alias pbpaste 'xclip -selection clipboard -o'
{{- end }}

alias vim nvim
alias vi nvim

# eza
if command -q eza
  alias l="eza --icons=auto"
  alias ls="eza --git --icons=auto"
  alias la="eza --git -a --icons=auto"
  alias ll="eza -lab --git --icons=auto"
  alias tree="eza --tree --icons=auto"
else
  alias l="ls"
  alias la="ls -a"
  alias ll="ls -al"
end

# bat
if command -q bat
  alias cat="bat --plain"
end

# jaq (Rust drop-in jq replacement)
if command -q jaq
  alias jq jaq
end

# rg
alias rg 'rg --hidden --follow --glob "!.git"'

# chezmoi
if command -q chezmoi
  alias d="chezmoi cd"
end

# toggle between audio devices
alias s 'command switch-audio'
