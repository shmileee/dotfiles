{{- $brewPrefix := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $brewPrefix = "/opt/homebrew" -}}
  {{- else if eq .chezmoi.arch "amd64" -}}
    {{- $brewPrefix = "/usr/local" -}}
  {{- end -}}
{{- else if or (env "DOCKERIZED") (eq .chezmoi.os "linux") -}}
  {{- $brewPrefix = "/home/linuxbrew/.linuxbrew" -}}
{{- end -}}

# Environment and PATH. Named 00-* so it is sourced before every other
# conf.d snippet: the mise/zoxide/direnv hooks below need PATH already set,
# and conf.d runs *before* config.fish, so none of this can live there.

set -gx XDG_CONFIG_HOME $HOME/.config
set -gx XDG_CACHE_HOME $HOME/.cache
set -gx EDITOR nvim
set -gx VISUAL nvim
# Custom theme from ~/.config/bat/themes, registered by the chezmoi
# run_onchange bat-cache script (bat cache --build). Used by bat itself
# (MANPAGER, fzf.fish previews); delta pins its own syntax-theme in gitconfig.
set -gx BAT_THEME tokyonight_moon
set -gx GOPATH $HOME/go
set -gx HOMEBREW_NO_ANALYTICS 1
# mise's embedded npm backend (aube) prompts (tty) or hard-refuses
# (non-interactive) for low-download npm packages; allowlist the vetted ones
# pinned in mise config so mise install/upgrade never stalls on them.
set -gx NPM_CONFIG_ALLOWED_UNPOPULAR_PACKAGES mcp-server-linear
# Two 1Password accounts are registered (personal + work), so a bare op
# command fails with "multiple accounts found". Default to personal;
# override per-command with `op --account <work-account-url>`.
set -gx OP_ACCOUNT my.1password.com

{{- if and (eq .chezmoi.os "darwin") $brewPrefix }}
set -gx DIRENV_BASH {{ $brewPrefix }}/bin/bash
{{- else }}
set -gx DIRENV_BASH /bin/bash
{{- end }}
set -gx DIRENV_LOG_FORMAT ''

# 1Password is the only SSH agent (private keys never touch disk). Point
# everything that talks to an agent (ssh-add, ansible, tools bypassing
# ~/.ssh/config) at its socket. ~/.1password/agent.sock is a chezmoi-managed
# symlink on macOS and 1Password's native socket path on Linux.
if test -S $HOME/.1password/agent.sock
    set -gx SSH_AUTH_SOCK $HOME/.1password/agent.sock
end

# -g keeps PATH session-scoped and fully declared here, instead of
# accumulating in the persistent universal fish_user_paths variable.
fish_add_path -g $GOPATH/bin
fish_add_path -g $HOME/.local/bin
fish_add_path -g $HOME/bin
fish_add_path -g $HOME/.cargo/bin
{{- if $brewPrefix }}
fish_add_path -g {{ $brewPrefix }}/bin
fish_add_path -g {{ $brewPrefix }}/sbin
fish_add_path -g {{ $brewPrefix }}/opt/libpq/bin
{{- end }}
