{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "small_model": "openai/gpt-5.4-mini",
  "experimental": {
    "mcp_timeout": 30000
  },
  "formatter": {
    "terramate": {
      "command": ["terramate", "fmt"],
      "extensions": [".tm.hcl"]
    }
  },
  "lsp": {
    "terramate": {
      "command": ["terramate-ls"],
      "extensions": [".tm.hcl"]
    }
  },
  "mcp": {
    "home-assistant": {
      "type": "remote",
      "enabled": false,
      "url": "{file:~/.config/opencode/secrets/home-assistant-mcp-url}",
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/secrets/home-assistant-access-token}"
      }
    }
  },
  "plugin": [
    "opencode-claude-auth@2.2.0",
    "oh-my-openagent@4.19.4",
    "opencode-contextual-notifier@0.1.2"
  ]
}
