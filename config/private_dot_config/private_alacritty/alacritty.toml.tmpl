{{- $shell := "" -}}
{{- $tmux := "" -}}
{{- $session := "main" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $shell = "/opt/homebrew/bin/fish" -}}
    {{- $tmux = "/opt/homebrew/bin/tmux" -}}
  {{- else if eq .chezmoi.arch "amd64" -}}
    {{- $shell = "/usr/local/bin/fish" -}}
    {{- $tmux = "/usr/local/bin/tmux" -}}
  {{- end -}}
{{- else if or (env "DOCKERIZED") (eq .chezmoi.os "linux") -}}
  {{- $shell = "/home/linuxbrew/.linuxbrew/bin/fish" -}}
  {{- $tmux = "/home/linuxbrew/.linuxbrew/bin/tmux" -}}
{{- end -}}
{{- $opener := "xdg-open" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- $opener = "open" -}}
{{- end -}}

# TokyoNight (moon) palette
# Source: https://github.com/folke/tokyonight.nvim/blob/main/extras/alacritty/tokyonight_moon.toml
[colors.primary]
background = "#222436"
foreground = "#c8d3f5"

[colors.normal]
black = "#1b1d2b"
red = "#ff757f"
green = "#c3e88d"
yellow = "#ffc777"
blue = "#82aaff"
magenta = "#c099ff"
cyan = "#86e1fc"
white = "#828bb8"

[colors.bright]
black = "#444a73"
red = "#ff8d94"
green = "#c7fb6d"
yellow = "#ffd8ab"
blue = "#9ab8ff"
magenta = "#caabff"
cyan = "#b2ebff"
white = "#c8d3f5"

[cursor]
# Fish's default bindings never emit a cursor-shape sequence, so the prompt
# shows the terminal default. blink_timeout = 0 keeps it blinking when idle
# (Alacritty otherwise stops after 5s).
style = { shape = "Block", blinking = "On" }
blink_interval = 500  # ms per blink phase; Alacritty default is 750
blink_timeout = 0

[font]
size = 14.0

[font.normal]
family = "FiraCode Nerd Font"

# Setting hints.enabled replaces Alacritty's defaults, so the stock URL hint is
# redefined first. See ~/bin/open-url for how file:// URLs are handled.
[[hints.enabled]]
command = "{{ .chezmoi.homeDir }}/bin/open-url"
hyperlinks = true
post_processing = true
persist = false
mouse = { enabled = true }
binding = { key = "O", mods = "Control|Shift" }
regex = "(ipfs:|ipns:|magnet:|mailto:|gemini://|gopher://|https://|http://|news:|file:|git://|ssh:|ftp://)[^\u0000-\u001F\u007F-\u009F<>\"\\s{-}\\^⟨⟩`\\\\]+"

# Copy a visible file path (optionally with :line) to the clipboard.
[[hints.enabled]]
action = "Copy"
post_processing = false
persist = false
binding = { key = "P", mods = "Command|Shift" }
regex = '[\w~.-]*(/[\w.-]+)+(:\d+)?'

[scrolling]
history = 0

[selection]
save_to_clipboard = true

[window]
decorations = "none"
dynamic_padding = true
startup_mode = "Maximized"
option_as_alt = "OnlyLeft"
resize_increments = true

[terminal.shell]
program = "{{ $shell }}"

# Killing the last pane destroys the session; the next launch recreates it.
args = ["-lc", "exec {{ $tmux }} -u new-session -As {{ $session }}"]

[keyboard]
# These run as external processes with no tmux client, so an untargeted command
# can hit the wrong session. Every command below names the session explicitly.
bindings = [
  { key = "Enter", mods = "Shift", chars = "\u001b[13;2u" },  # CSI-u, so TUIs (opencode) can tell it from Enter
  { key = "Tab", mods = "Control", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:+"] } },
  { key = "Tab", mods = "Shift|Control", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:-"] } },
  { key = "F", mods = "Command", command = { program = "{{ $tmux }}", args = [ "copy-mode", "-t", "{{ $session }}", ";", "command-prompt", "-i", "-I", "#{pane_search_string}", "-p", "(search down)", "send -X search-forward-incremental \"%%%\"" ] } },
  { key = "Key1", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:1"] } },
  { key = "Key2", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:2"] } },
  { key = "Key3", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:3"] } },
  { key = "Key4", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:4"] } },
  { key = "Key5", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:5"] } },
  { key = "Key6", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:6"] } },
  { key = "Key7", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:7"] } },
  { key = "Key8", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:8"] } },
  { key = "Key9", mods = "Command", command = { program = "{{ $tmux }}", args = ["select-window", "-t", "{{ $session }}:9"] } },
  { key = "T", mods = "Command", command = { program = "{{ $tmux }}", args = ["new-window", "-t", "{{ $session }}", "-c", "#{pane_current_path}"] } },
  { key = "R", mods = "Command|Shift", command = { program = "{{ $tmux }}", args = ["command-prompt", "rename-session -t {{ $session }} -- '%%'"] } },
  { key = "W", mods = "Command",  command = { program = "{{ $tmux }}", args = ["kill-window", "-t", "{{ $session }}"] } },
  { key = "X", mods = "Command",  command = { program = "{{ $tmux }}", args = ["kill-pane", "-t", "{{ $session }}"] } },
]
